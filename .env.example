# Copy to `.env` and fill in. Nothing here is read at import time — the client
# starts without credentials and reports each connection as unconfigured.

# Outgoing mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=
SMTP_FROM=you@example.com
# Optional. `:testmail` sends here so you can verify SMTP without picking a
# recipient by hand.
SMTP_TEST_TO=you@example.com

# Incoming mail.
IMAP_HOST=imap.example.com
IMAP_USER=you@example.com
IMAP_PASS=

# Most providers reject your account password over IMAP/SMTP. Generate an
# app-specific password instead — Gmail, iCloud, and Fastmail all require one
# when two-factor auth is on.
